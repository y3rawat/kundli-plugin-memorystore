# ==============================================================================
# MemoryStore Kundli & Astrology Plugin - Environment Configuration
# ==============================================================================

PORT=3456
SERVER_BASE_URL=http://localhost:3456

# Shared HMAC Secret for verifying webhooks from MemoryStore
MEMORYSTORE_PLUGIN_SECRET=mst_plugin_secret_astrology_123

# ------------------------------------------------------------------------------
# Firebase Admin Credentials (Server-Side Storage)
# ------------------------------------------------------------------------------
# Option A: Single JSON string or path to service account key file
FIREBASE_SERVICE_ACCOUNT_KEY=

# Option B: Individual Service Account fields
FIREBASE_PROJECT_ID=memorystore-kundli-plugin
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# AI Configuration Note:
# The Gemini API key is provided dynamically by the USER from the MemoryStore App
# (passed per-request via user_config / webhook).
# The key below is strictly OPTIONAL as a local development / fallback override.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
